{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "forkProcessing": "enabled",
  "schedule": ["before 6am on monday"],
  "packageRules": [
    {
      "description": "Alchemist stays on 49.1.0, as agreed for the thesis",
      "matchPackageNames": ["it.unibo.alchemist:**"],
      "enabled": false
    },
    { "groupName": "LangChain4j", "matchPackageNames": ["dev.langchain4j:**"] },
    { "groupName": "GitHub Actions", "matchManagers": ["github-actions"] },
    { "groupName": "Java", "matchDepNames": ["java-jdk", "eclipse-temurin"] },
    { "groupName": "non-major", "matchUpdateTypes": ["minor", "patch"], "matchPackageNames": ["!dev.langchain4j:**"] }
  ],
  "customManagers": [
    {
      "description": "Java dependencies in build.mill: mvn\"group:artifact:version\"",
      "customType": "regex",
      "managerFilePatterns": ["/^build\\.mill$/"],
      "matchStrings": ["mvn\"(?<depName>[^:\"]+:[^:\"]+):(?<currentValue>[^:\"$]+)\""],
      "datasourceTemplate": "maven"
    },
    {
      "description": "Scala dependencies in build.mill: mvn\"group::artifact:version\"",
      "customType": "regex",
      "managerFilePatterns": ["/^build\\.mill$/"],
      "matchStrings": ["mvn\"(?<groupId>[^:\"]+)::(?<artifactId>[^:\"]+):(?<currentValue>[^:\"$]+)\""],
      "depNameTemplate": "{{{groupId}}}:{{{artifactId}}}_3",
      "datasourceTemplate": "maven"
    },
    {
      "description": "Mill version",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.mill-version$/"],
      "matchStrings": ["^(?<currentValue>\\S+)"],
      "depNameTemplate": "com.lihaoyi:mill-dist",
      "datasourceTemplate": "maven"
    }
  ]
}
