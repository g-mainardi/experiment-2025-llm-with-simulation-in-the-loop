package build
import mill.*, scalalib.*

val scala2Version = "2.13.17"

trait Common extends SbtModule {
  def scalaVersion = scala2Version
  def scalacOptions = Seq(
    "-deprecation",
    "-encoding", "utf8",
    "-feature",
    "-unchecked",
  )
}

object mcp_server extends Common {
  def mvnDeps = Seq(
    mvn"com.google.guava:guava:33.5.0-jre",
    mvn"org.scala-lang:scala-compiler:${scalaVersion()}",
    mvn"it.unibo.alchemist:alchemist:42.3.7".excludeName("guava"),
    mvn"it.unibo.alchemist:alchemist-swingui:42.3.7".excludeName("guava"),
    mvn"it.unibo.alchemist:alchemist-maps:42.3.7".excludeName("guava"),
    mvn"it.unibo.alchemist:alchemist-incarnation-scafi:42.3.7".excludeName("guava"),
    mvn"it.unibo.scafi::scafi-core:1.6.0",
    mvn"io.modelcontextprotocol.sdk:mcp:0.14.1",
    mvn"io.modelcontextprotocol.sdk:mcp-core:0.14.1",
    mvn"io.modelcontextprotocol.sdk:mcp-json:0.14.1",
    mvn"org.slf4j:slf4j-simple:2.0.9",
    // Plotting
    mvn"io.github.pityka::nspl-awt:0.11.1",
    // CSV
    mvn"com.github.tototoshi::scala-csv:2.0.0",
  )
  
//  def mainClass = Some("it.unibo.llm.Main")
  override def forkArgs = Seq("-Dsun.java2d.opengl=false")
  def mainClass = Some("it.unibo.llm.mcp.server.ServerMain")

  def prependShellScript = ""
}

object simulation_agent extends Common {
  def moduleDeps = Seq(
    mcp_server,
  )
  
  def mvnDeps = Seq(
    mvn"org.slf4j:slf4j-simple:2.0.9",
    mvn"org.bsc.langgraph4j:langgraph4j-core:1.7.2",
    mvn"org.bsc.langgraph4j:langgraph4j-langchain4j:1.7.2",
    mvn"org.bsc.langgraph4j:langgraph4j-agent-executor:1.7.2",
    mvn"dev.langchain4j:langchain4j:1.8.0",
    mvn"dev.langchain4j:langchain4j-mcp:1.8.0-beta15",
    mvn"dev.langchain4j:langchain4j-google-ai-gemini:1.8.0",
  )

  override def forkArgs = Seq("-Dsun.java2d.opengl=false")
  def mainClass = Some("it.unibo.llm.agent.Main")
  def prependShellScript = ""
}