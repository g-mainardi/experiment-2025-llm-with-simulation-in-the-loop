package build
import mill.*, scalalib.*

val scala3Version = "3.10.0"

// Enables the versioned Git hooks in .githooks/ and the formatting commits skipped by git blame
// on every Mill run (skipped where there is no repo, e.g. Docker)
if (os.exists(mill.api.BuildCtx.workspaceRoot / ".git")) {
  os.call(("git", "config", "core.hooksPath", ".githooks"), cwd = mill.api.BuildCtx.workspaceRoot)
  os.call(("git", "config", "blame.ignoreRevsFile", ".git-blame-ignore-revs"), cwd = mill.api.BuildCtx.workspaceRoot)
}

trait Common extends SbtModule {
  def scalaVersion = scala3Version
  def scalacOptions = Seq(
    "-deprecation", "-encoding", "utf8", "-feature", "-unchecked"
  )
}

object mcp_server extends Common {
  def mvnDeps = Seq(
    mvn"com.google.guava:guava:33.7.2-jre",
    mvn"org.scala-lang::scala3-compiler:${scalaVersion()}",
    mvn"it.unibo.alchemist:alchemist:49.1.0".excludeName("logback-classic"),
    // javalib-java7 (from swingui) pins Guava to [11.0, 19.0-rc2], which conflicts with the version above
    mvn"it.unibo.alchemist:alchemist-swingui:49.1.0".excludeName("guava", "logback-classic"),
    mvn"it.unibo.alchemist:alchemist-incarnation-scafi:49.1.0",
    mvn"it.unibo.scafi::scafi-core:1.8.0",
    // Classloader Alchemist loads ScaFi programs with, used directly by ScafiTestUtils (runtime-only in Alchemist)
    mvn"org.danilopianini:thread-inheritable-resource-loader:0.3.8",
    mvn"io.modelcontextprotocol.sdk:mcp",
    mvn"jakarta.servlet:jakarta.servlet-api:6.1.0",
    mvn"org.eclipse.jetty:jetty-servlet:11.0.26",
    // SLF4J binding; logback-classic, pulled in by Alchemist, is excluded above to keep it the only one
    mvn"org.slf4j:slf4j-simple:2.0.20",
    // Plotting
    mvn"io.github.pityka::nspl-awt:0.19.0",
    // CSV
    mvn"com.github.tototoshi::scala-csv:2.0.0"
  )

  override def bomMvnDeps = Seq(
    mvn"io.modelcontextprotocol.sdk:mcp-bom:2.1.0"
  )

//  def mainClass = Some("it.unibo.llm.Main")
  override def forkArgs = Seq("-Dsun.java2d.opengl=false")
  def mainClass = Some("it.unibo.llm.mcp.server.ServerMain")

  def prependShellScript = ""

  // Dev-only tools (SimulationProbe), kept out of the server jar; no tests yet
  object test extends SbtTests with scalalib.TestModule.Junit4 {
    override def forkArgs = Seq("-Dsun.java2d.opengl=false")
  }
}

object simulation_agent extends Common {
  def mvnDeps = Seq(
    mvn"ch.qos.logback:logback-classic:1.6.6",
    mvn"dev.langchain4j:langchain4j:1.23.0",
    mvn"dev.langchain4j:langchain4j-mcp:1.23.0-beta33",
    mvn"dev.langchain4j:langchain4j-google-ai-gemini:1.23.0",
    mvn"dev.langchain4j:langchain4j-ollama:1.23.0"
  )

  override def forkArgs = Seq("-Dsun.java2d.opengl=false")
  def mainClass = Some("it.unibo.llm.agent.Main")
  def prependShellScript = ""
}

object exp extends Common {
  def moduleDeps = Seq(simulation_agent)
  def mainClass = Some("it.unibo.llm.exp.Matrix")

  def matrix(
      @mainargs.arg(positional = true) dir: String = "runs/matrix-" + java.time.LocalDate.now.format(java.time.format.DateTimeFormatter.BASIC_ISO_DATE),
      k: Int = 10, jobs: Int = 4, tasks: String = "all", cells: String = "base-none,base-compile,base-full,bare-full"
  ) = Task.Command(exclusive = true) {
    val evaluatorClasspath = mcp_server.runClasspath().map(_.path).mkString(java.io.File.pathSeparator)
    // Keep the same shell syntax for .env as the agent setup, and keep credentials out of Mill's task outputs.
    os.proc("bash", "-eac", "if [[ -f .env ]]; then source ./.env; fi; exec \"$@\"",
      "exp.matrix", launcher().path, simulation_agent.launcher().path, evaluatorClasspath, dir, k.toString,
      jobs.toString, tasks, cells).call(
      cwd = mill.api.BuildCtx.workspaceRoot,
      env = Task.env,
      stdout = os.Inherit,
      stderr = os.Inherit
    )
    ()
  }

  def summary(@mainargs.arg(positional = true) dir: String) = Task.Command {
    runner().run(args = Seq(dir), mainClass = "it.unibo.llm.exp.Summary", workingDir = forkWorkingDir())
  }

  object test extends SbtTests with scalalib.TestModule.Junit4
}
